    <!-- File Appender -->
    <appender name="ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">

        <!-- Where your latest active log is written -->
        <file>/var/log/app/inmemory/application.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Directory and pattern for rolled files -->
            <fileNamePattern>/var/logs/myapp/application-%d{yyyy-MM-dd}.log</fileNamePattern>

            <!-- Keep 30 days of logs -->
            <maxHistory>30</maxHistory>

            <!-- Optional: Max total size of all archived logs -->
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Async Appender to handle both Kafka and File -->
    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>5000</queueSize>
       <!-- <appender-ref ref="KAFKA"/>-->
        <appender-ref ref="ROLLING"/>
    </appender>

    <!-- Root Logger Configuration -->
    <root level="INFO">
        <appender-ref ref="ASYNC"/>
    </root>


</configuration>
